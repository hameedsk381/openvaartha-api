---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';
import { getArticles, type Article } from '../lib/api';
import '../styles/landing.css';

let featured: Article[] = [];
try {
  const latest = await getArticles({ limit: 3 });
  featured = latest.slice(0, 3);
} catch {
  // API not reachable at render time, the reading list mock shows its empty state.
}

const tagline =
  'Journalism that answers to readers, not to advertisers, algorithms, or anyone with a chequebook.';
const taglineWords = tagline.split(' ');

const faqs = [
  {
    q: 'Is Open Vaartha free to read?',
    a: 'Yes. Every story is free to read and creating an account costs nothing. We do not put reporting behind a paywall.',
  },
  {
    q: 'Do I need an account to read?',
    a: 'No. Anyone can read the site. An account adds a reading list, your reading history and the morning digest.',
  },
  {
    q: 'What does an account store?',
    a: 'Your name, your email address, the stories you save and the stories you open. Our privacy policy sets out what we keep and why.',
  },
  {
    q: 'Do you take advertising?',
    a: 'Our reporting is not driven by advertising revenue. Donations to the FOSS Andhra Foundation keep the newsroom running.',
  },
  {
    q: 'How often will you email me?',
    a: 'One digest each morning with the day\u2019s reporting from Andhra Pradesh. You can unsubscribe from any message.',
  },
  {
    q: 'How do you handle mistakes?',
    a: 'We correct errors promptly and log every correction on the corrections page, so the record stays visible.',
  },
  {
    q: 'Can I write for Open Vaartha?',
    a: 'Yes. Once you have an account you can submit a contribution from the writer portal.',
  },
  {
    q: 'I forgot my password. What now?',
    a: 'Use the reset link on the sign in page. We email you a link to set a new password.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const benefits = [
  {
    n: '01',
    title: 'Your reading list, in one place',
    body: 'Save a story on your phone and it is waiting on your laptop. Nothing gets lost in a browser tab.',
  },
  {
    n: '02',
    title: 'Pick up where you stopped',
    body: 'Reading history marks every article you open, so a long report is easy to return to.',
  },
  {
    n: '03',
    title: 'One email each morning',
    body: 'The day\u2019s reporting from Andhra Pradesh in a single digest. One message, then your day.',
  },
  {
    n: '04',
    title: 'A record you can check',
    body: 'Our standards are published and every correction is logged in public. You can hold us to both.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Create an account',
    body: 'A name, an email address and a password. It takes a minute and costs nothing.',
  },
  {
    n: '02',
    title: 'Save as you read',
    body: 'Keep the stories you want to finish, or come back to, in your reading list.',
  },
  {
    n: '03',
    title: 'Return when it suits you',
    body: 'Open your list from any device, or start the morning with the digest.',
  },
];
---

<Base
  title={pageTitle('Create a free account')}
  description="Create a free Open Vaartha account to save stories, keep your reading history and get the morning digest. No card, no paywall."
  canonical={`${BRAND.url}/join`}
>
  <div class="lp">
    <!-- Hero -->
    <section class="px-6 pt-16 pb-16 md:pt-24 md:pb-24" aria-label="Open Vaartha">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <h1 class="heading-1 hero-heading max-w-[680px]">
            Keep the stories<br />that matter to<br />Andhra Pradesh.
          </h1>

          <p class="title-2 mt-6 max-w-[680px]">
            A free account saves what you read, keeps your place, and sends one digest each
            morning.
          </p>

          <div class="mt-8">
            <a href="/register" class="lp-btn lp-btn--primary button-md">Create free account</a>
          </div>

          <p class="caption-2 mt-4">Free account, no card, no paywall.</p>
          <p class="caption-5 mt-2 lp-soft">
            Published by the FOSS Andhra Foundation. Every correction is logged in public.
          </p>
        </div>

        <figure class="lp-card" aria-label="A preview of the reading list">
          <div class="lp-mock-head">
            <span class="title-3">Your reading list</span>
            <span class="caption-5 lp-soft">
              {featured.length > 0 ? `${featured.length} saved` : 'Empty list'}
            </span>
          </div>

          {featured.length > 0 ? (
            featured.map((article, index) => (
              <div class="lp-mock-row">
                <span class="lp-mock-mark caption-5">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <span class="lp-mock-title title-3 block">{article.title}</span>
                  <span class="lp-mock-meta caption-5 block">
                    {article.category}
                    {article.read_time ? ` \u00b7 ${article.read_time}` : ''}
                  </span>
                </span>
              </div>
            ))
          ) : (
            <p class="lp-mock-empty body-6">
              Saved stories appear here once you create an account.
            </p>
          )}

          <div class="lp-mock-foot">
            <span class="caption-2">Morning digest</span>
            <span class="caption-5 lp-soft">One email each morning</span>
          </div>
        </figure>
      </div>
    </section>

    <!-- Tagline reveal -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="What we promise readers">
      <div class="mx-auto max-w-6xl">
        <p class="lp-tagline heading-3">
          {taglineWords.map((word, index) => (
            <>
              <span class="lp-word">{word}</span>
              {index < taglineWords.length - 1 ? ' ' : ''}
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- Problem to solution -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="Why this newsroom exists">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:gap-16">
        <h2 class="heading-4 max-w-[560px]">
          The feed rewrites itself every hour. The record does not.
        </h2>
        <div class="space-y-4">
          <p class="body-3">
            Feeds rank stories by what holds your attention. The story that mattered on Tuesday is
            gone by Thursday, and the correction, when it comes, is easy to miss.
          </p>
          <p class="body-3">
            Open Vaartha reports on politics, governance, society, technology and the environment
            across Andhra Pradesh. We publish our standards and log every correction where you can
            find it. An account gives you a place to keep what you read.
          </p>
          <p>
            <a href="/editorial" class="lp-link body-2">Read our editorial standards &rarr;</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="What an account gives you">
      <div class="mx-auto max-w-6xl">
        <h2 class="heading-3 max-w-[680px]">What an account gives you</h2>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {benefits.map((benefit) => (
            <div class="lp-card" data-reveal>
              <div class="lp-tile flex flex-col gap-2">
                <span class="caption-3 lp-soft">{benefit.n}</span>
                <h3 class="title-2">{benefit.title}</h3>
                <p class="body-6 lp-soft">{benefit.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="How it works">
      <div class="mx-auto max-w-6xl">
        <h2 class="heading-3 max-w-[680px]">Three steps, then you are reading.</h2>

        <ol class="mt-8 grid gap-8 md:grid-cols-3">
          {steps.map((step) => (
            <li class="flex flex-col gap-2" data-reveal>
              <span class="caption-3 lp-soft">{step.n}</span>
              <h3 class="title-2">{step.title}</h3>
              <p class="body-6 lp-soft">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Standards -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="Our standards">
      <div class="mx-auto max-w-6xl">
        <h2 class="heading-3 max-w-[680px]">Read the rules we work under.</h2>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <a href="/editorial" class="lp-card lp-story group block h-full">
            <div class="lp-tile flex h-full flex-col gap-2">
              <h3 class="title-3">Editorial standards</h3>
              <p class="body-6 lp-soft">How we verify, source and attribute.</p>
              <span class="caption-2 lp-accent mt-auto">Read &rarr;</span>
            </div>
          </a>
          <a href="/corrections" class="lp-card lp-story group block h-full">
            <div class="lp-tile flex h-full flex-col gap-2">
              <h3 class="title-3">Corrections</h3>
              <p class="body-6 lp-soft">Every correction we publish, in one log.</p>
              <span class="caption-2 lp-accent mt-auto">Read &rarr;</span>
            </div>
          </a>
          <a href="/about" class="lp-card lp-story group block h-full">
            <div class="lp-tile flex h-full flex-col gap-2">
              <h3 class="title-3">About us</h3>
              <p class="body-6 lp-soft">Who runs the newsroom and who pays for it.</p>
              <span class="caption-2 lp-accent mt-auto">Read &rarr;</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="Morning digest">
      <div class="mx-auto max-w-6xl">
        <div class="lp-card">
          <div class="lp-tile lp-tile--tint">
            <div class="max-w-[680px]">
              <h2 class="heading-5">One email each morning.</h2>
              <p class="body-6 mt-2 lp-soft">
                The day's reporting from Andhra Pradesh in a single digest. Unsubscribe whenever
                you like.
              </p>

              <form id="lp-subscribe" class="lp-field mt-6" novalidate>
                <label for="lp-email" class="sr-only">Email address</label>
                <input
                  id="lp-email"
                  class="lp-input body-3"
                  type="email"
                  name="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  required
                />
                <button type="submit" class="lp-btn lp-btn--primary button-md">
                  Get the morning digest
                </button>
              </form>
              <p id="lp-subscribe-note" class="lp-form-note caption-5 mt-2" role="status" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="Questions and answers">
      <div class="mx-auto max-w-6xl">
        <h2 class="heading-3">Questions readers ask</h2>

        <div class="lp-faq mt-8 max-w-[680px]">
          {faqs.map((faq) => (
            <details class="lp-faq-item">
              <summary class="title-3">
                <span>{faq.q}</span>
                <span class="lp-faq-toggle caption-2" aria-hidden="true">+</span>
              </summary>
              <p class="lp-faq-answer body-6 lp-soft">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="lp-rule px-6 py-16 md:py-24" aria-label="Create your account">
      <div class="mx-auto max-w-[680px] text-center">
        <h2 class="heading-3">Keep the stories that matter to you.</h2>
        <p class="body-3 mt-4">
          A free account takes a minute. Your reading list, history and the morning digest come
          with it.
        </p>
        <div class="mt-8">
          <a href="/register" class="lp-btn lp-btn--primary button-md">Create free account</a>
        </div>
        <p class="caption-2 mt-4">Free account, no card, no paywall.</p>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

    <noscript>
      <style>
        .lp [data-reveal] {
          opacity: 1;
          transform: none;
        }

        .lp-word {
          opacity: 1;
        }
      </style>
    </noscript>
  </div>
</Base>

<script>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const supportsObserver = 'IntersectionObserver' in window;

    const reveals = document.querySelectorAll('[data-reveal]');
    if (reduceMotion || !supportsObserver) {
      reveals.forEach((element) => element.classList.add('is-in'));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );
      reveals.forEach((element) => revealObserver.observe(element));
    }

    const words = document.querySelectorAll('.lp-word');
    if (reduceMotion || !supportsObserver) {
      words.forEach((word) => word.classList.add('is-on'));
    } else {
      const wordObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-on');
            wordObserver.unobserve(entry.target);
          });
        },
        { threshold: 0, rootMargin: '0px 0px -35% 0px' }
      );
      words.forEach((word) => wordObserver.observe(word));
    }

    const form = document.getElementById('lp-subscribe');
    const note = document.getElementById('lp-subscribe-note');
    if (!form || !note) return;

    const input = form.querySelector('input[type="email"]');
    const button = form.querySelector('button');
    const isEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);

    const setNote = (message, tone) => {
      note.textContent = message;
      if (tone) {
        note.dataset.tone = tone;
      } else {
        delete note.dataset.tone;
      }
    };

    input.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      if (note.dataset.tone === 'error') setNote('', null);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = input.value.trim();

      if (!isEmail(value)) {
        input.setAttribute('aria-invalid', 'true');
        setNote('Enter an email address, like name@example.com.', 'error');
        input.focus();
        return;
      }

      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Sending';
      setNote('', null);

      try {
        const response = await fetch('/api/v1/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: value }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        button.textContent = 'Subscribed';
        setNote('You are on the list. The first digest arrives tomorrow morning.', null);
      } catch {
        button.textContent = label;
        button.disabled = false;
        setNote('Subscription failed. Try again in a moment.', 'error');
      }
    });
  })();
</script>
