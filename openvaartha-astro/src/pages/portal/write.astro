---
import Base from '../../layouts/Base.astro';
import { BRAND, pageTitle } from '../../lib/brand';
import WriteEditor from '../../components/WriteEditor';
---

<Base title={pageTitle('Write')} description="Submit a community contribution." canonical={`${BRAND.url}/portal/write`} noindex={true}>
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-10 py-10 sm:py-14">
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-8">
      <a href="/" class="hover:text-primary transition-colors">Home</a><span>/</span>
      <a href="/portal" class="hover:text-primary transition-colors">Dashboard</a><span>/</span>
      <span class="text-foreground font-medium">Write</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight mb-8">Write a Contribution</h1>
    <WriteEditor client:load />
  </div>
</Base>
