---
import Base from '../../layouts/Base.astro';
import { BRAND, pageTitle } from '../../lib/brand';
import { getArticleBySlug } from '../../lib/api';
import AudioPlayer from '../../components/AudioPlayer';
import Reactions from '../../components/Reactions';
import Comments from '../../components/Comments';
import QuoteCard from '../../components/QuoteCard';

const { slug } = Astro.params;

let article = null;
try {
  article = await getArticleBySlug(slug);
} catch (e) {
  return Astro.redirect('/404');
}

if (!article) return Astro.redirect('/404');
---

<Base
  title={pageTitle(article.title)}
  description={article.summary}
  canonical={`${BRAND.url}/article/${article.slug}`}
  ogImage={article.thumbnail_url || `${BRAND.url}/og-default.png`}
>
  {/* Breadcrumb */}
  <nav aria-label="Breadcrumb" class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 pt-4 pb-0">
    <ol class="flex items-center gap-2 text-xs text-muted-foreground">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/category/${article.category?.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-primary transition-colors">{article.category}</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-foreground font-medium truncate max-w-[200px]" aria-current="page">{article.title}</li>
    </ol>
  </nav>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-10 py-8 sm:py-12">
    {/* Category + timestamp */}
    <div class="flex items-center gap-3 mb-5">
      <a href={`/category/${article.category?.toLowerCase().replace(/\s+/g, '-')}`} class="overline text-primary hover:underline underline-offset-4">{article.category}</a>
      <span class="h-1 w-1 rounded-full bg-border" />
      <time datetime={article.published_at} class="text-[11px] text-muted-foreground font-medium tracking-wide">
        {new Date(article.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </div>

    {/* Title */}
    <h1 class="font-serif text-3xl sm:text-5xl font-bold leading-tight tracking-tight mb-4">{article.title}</h1>

    {/* Summary */}
    {article.summary && (
      <p class="font-serif text-lg text-muted-foreground leading-relaxed mb-6 max-w-3xl">{article.summary}</p>
    )}

    {/* Author + read time */}
    <div class="flex items-center gap-3 text-sm text-muted-foreground mb-8 pb-8 border-b border-border">
      <span class="font-medium text-foreground">{article.author || BRAND.authorName}</span>
      {article.read_time && (<><span class="h-1 w-1 rounded-full bg-border" /><span>{article.read_time}</span></>)}
    </div>

    {/* Thumbnail */}
    {article.thumbnail_url && (
      <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-muted mb-10">
        <img src={article.thumbnail_url} alt={article.title} class="w-full h-full object-cover" loading="eager" />
      </div>
    )}

    {/* Audio Player */}
    <div class="mb-8">
      <AudioPlayer client:load articleSlug={article.slug} title={article.title} />
    </div>

    {/* Article body */}
    <div id="article-content" class="article-body prose prose-lg max-w-none" data-article-id={article._id}>
      {article.body ? (
        <Fragment set:html={article.body} />
      ) : (
        <p class="text-muted-foreground italic">Article body is loaded client-side. Full SSR coming soon.</p>
      )}
    </div>

    {/* Tags */}
    {article.tags && article.tags.length > 0 && (
      <div class="mt-10 pt-6 border-t border-border">
        <div class="flex flex-wrap gap-2">
          {article.tags.map((tag: string) => (
            <a href={`/topic/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="chip-ghost">{tag}</a>
          ))}
        </div>
      </div>
    )}

    {/* Reactions */}
    <div class="mt-10 pt-6 border-t border-border">
      <h3 class="font-display text-sm font-bold mb-4">Reactions</h3>
      <Reactions client:load articleSlug={article.slug} />
    </div>

    {/* Share / Quote Card */}
    <div class="mt-10 pt-6 border-t border-border">
      <QuoteCard client:visible title={article.title} slug={article.slug} summary={article.summary} category={article.category} />
    </div>

    {/* Comments */}
    <div class="mt-10 pt-6 border-t border-border">
      <Comments client:load articleSlug={article.slug} />
    </div>
  </article>
</Base>
