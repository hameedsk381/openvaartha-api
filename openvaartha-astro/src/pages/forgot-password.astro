---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';
import ForgotPasswordForm from '../components/ForgotPasswordForm';
---

<Base title={pageTitle('Forgot Password')} description="Reset your Open Vaartha password." canonical={`${BRAND.url}/forgot-password`} noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="font-display text-3xl font-bold tracking-tight">Forgot password?</h1>
        <p class="text-muted-foreground mt-2">Enter your email and we'll send you a reset link.</p>
      </div>

      <div class="card-base p-6 sm:p-8">
        <ForgotPasswordForm client:load />
      </div>

      <p class="text-center text-sm text-muted-foreground mt-6">
        <a href="/login" class="text-primary font-medium hover:underline">&larr; Back to sign in</a>
      </p>
    </div>
  </div>
</Base>
