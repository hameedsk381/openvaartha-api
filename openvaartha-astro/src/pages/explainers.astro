---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';

let articles = [];
try {
  const res = await fetch(`${import.meta.env.SITE_API_URL || 'http://localhost:8000/api/v1'}/articles/explainers?limit=20`);
  if (res.ok) articles = await res.json();
} catch (e) {}
---

<Base
  title={pageTitle('Explainers')}
  description="In-depth explainers on the issues that matter."
  canonical={`${BRAND.url}/explainers`}
>
  <section class="px-4 sm:px-6 lg:px-10 py-10 sm:py-14">
    <div class="max-w-screen-xl mx-auto">
      <span class="overline text-primary mb-3 block">Deep dives</span>
      <h1 class="poster text-4xl sm:text-6xl font-bold tracking-tight mb-2">Explainers</h1>
      <p class="text-muted-foreground mb-8">In-depth breakdowns of the stories behind the headlines.</p>

      {articles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((article: any) => (
            <a href={`/article/${article.slug}`} class="group block">
              {article.thumbnail_url && (
                <div class="aspect-[16/9] overflow-hidden rounded-xl bg-muted mb-4">
                  <img src={article.thumbnail_url} alt={article.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </div>
              )}
              <h3 class="font-serif text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3">{article.title}</h3>
              <p class="text-sm text-muted-foreground mt-2 line-clamp-2">{article.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-muted-foreground text-center py-16">No explainers yet.</p>
      )}
    </div>
  </section>
</Base>
