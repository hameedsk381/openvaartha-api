---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';
import ResetPasswordForm from '../components/ResetPasswordForm';
---

<Base title={pageTitle('Reset Password')} description="Reset your Open Vaartha password." canonical={`${BRAND.url}/reset-password`} noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="font-display text-3xl font-bold tracking-tight">Set new password</h1>
        <p class="text-muted-foreground mt-2">Choose a strong password for your account.</p>
      </div>

      <div class="card-base p-6 sm:p-8">
        <ResetPasswordForm client:load />
      </div>
    </div>
  </div>
</Base>
