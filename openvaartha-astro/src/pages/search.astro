---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';
import SearchOverlay from '../components/SearchOverlay';
---

<Base
  title={pageTitle('Search')}
  description="Search Open Vaartha."
  canonical={`${BRAND.url}/search`}
  noindex={true}
>
  <section class="px-4 sm:px-6 lg:px-10 py-10 sm:py-14">
    <div class="max-w-screen-xl mx-auto">
      <h1 class="poster text-4xl sm:text-6xl font-bold tracking-tight mb-8">Search</h1>
      <div class="max-w-2xl">
        <SearchOverlay client:load open={true} onClose={() => {}} />
      </div>
    </div>
  </section>
</Base>
