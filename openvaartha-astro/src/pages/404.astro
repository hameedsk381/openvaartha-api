---
import Base from '../layouts/Base.astro';
import { BRAND } from '../lib/brand';
---

<Base title="Page not found" description="The page you're looking for doesn't exist." noindex={true}>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
      <p class="font-display text-8xl font-bold text-primary/20">404</p>
      <h1 class="font-serif text-2xl font-bold mt-4">Page not found</h1>
      <p class="text-muted-foreground mt-2">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-flex items-center h-10 px-5 mt-6 rounded-full bg-primary text-primary-foreground text-sm font-bold hover:bg-primary-hover transition-colors">
        Go home
      </a>
    </div>
  </div>
</Base>
