---
import Base from '../layouts/Base.astro';
import { BRAND, pageTitle } from '../lib/brand';
import LoginForm from '../components/LoginForm';
---

<Base title={pageTitle('Sign In')} description="Sign in to Open Vaartha." canonical={`${BRAND.url}/login`} noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="font-display text-3xl font-bold tracking-tight">Welcome back</h1>
        <p class="text-muted-foreground mt-2">Sign in to your Open Vaartha account</p>
      </div>

      <div class="card-base p-6 sm:p-8">
        <LoginForm client:load />
      </div>

      <p class="text-center text-sm text-muted-foreground mt-6">
        Don't have an account? <a href="/register" class="text-primary font-medium hover:underline">Create one</a>
      </p>
    </div>
  </div>
</Base>
