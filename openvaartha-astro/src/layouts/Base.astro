---
import { BRAND, SITE_TITLE } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = BRAND.description,
  canonical = BRAND.url,
  ogImage = `${BRAND.url}/og-default.png`,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={BRAND.lang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content={BRAND.themeColor} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={BRAND.name} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href={BRAND.iconPath} />
  <link rel="apple-touch-icon" href={BRAND.iconPath} />

  <!-- JSON-LD Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsMediaOrganization",
    "name": BRAND.name,
    "url": BRAND.url,
    "logo": `${BRAND.url}${BRAND.logoPath}`,
    "sameAs": [
      BRAND.instagramUrl,
      BRAND.facebookUrl,
      BRAND.youtubeUrl,
    ],
  })} />
</head>
<body class="min-h-screen bg-background text-foreground">
  <!-- Navbar -->
  <nav class="sticky top-0 z-50 bg-background/95 backdrop-blur-xl border-b border-border">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="flex items-center justify-between h-14">
        <a href="/" class="flex items-center gap-2">
          <span class="font-display text-xl font-extrabold tracking-tight">
            Open<span class="text-primary">vaartha</span>
          </span>
        </a>

        <div class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/trending" class:list={["hover:text-primary transition-colors", { "text-primary font-bold": currentPath === "/trending" }]}>Trending</a>
          <a href="/explainers" class:list={["hover:text-primary transition-colors", { "text-primary font-bold": currentPath === "/explainers" }]}>Explainers</a>
          <a href="/feed" class:list={["hover:text-primary transition-colors", { "text-primary font-bold": currentPath === "/feed" }]}>Feed</a>
          <a href="/about" class:list={["hover:text-primary transition-colors", { "text-primary font-bold": currentPath === "/about" }]}>About</a>
        </div>

        <div class="flex items-center gap-3">
          <a href="/search" class="p-2 hover:bg-muted rounded-lg transition-colors" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main id="main-content" class="pb-safe">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-border bg-[hsl(var(--surface))]">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 py-10 sm:py-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-10">
        <div class="md:col-span-4">
          <div class="font-display text-2xl font-extrabold tracking-tight mb-3">
            Open<span class="text-primary">vaartha</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">{BRAND.tagline}</p>
          <div class="flex items-center gap-3 mt-4">
            <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href={BRAND.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href={BRAND.youtubeUrl} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
            </a>
          </div>
        </div>

        <div class="md:col-span-2">
          <p class="overline mb-4">Sections</p>
          <ul class="space-y-2.5">
            <li><a href="/trending" class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">Trending</a></li>
            <li><a href="/explainers" class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">Explainers</a></li>
            <li><a href="/feed" class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">Feed</a></li>
          </ul>
        </div>

        <div class="md:col-span-2">
          <p class="overline mb-4">About</p>
          <ul class="space-y-2.5">
            <li><a href="/about" class="text-sm text-muted-foreground hover:text-primary transition-colors">About us</a></li>
            <li><a href="/editorial" class="text-sm text-muted-foreground hover:text-primary transition-colors">Editorial standards</a></li>
            <li><a href="/corrections" class="text-sm text-muted-foreground hover:text-primary transition-colors">Corrections</a></li>
            <li><a href="/contact" class="text-sm text-muted-foreground hover:text-primary transition-colors">Contact</a></li>
          </ul>
        </div>

        <div class="md:col-span-2">
          <p class="overline mb-4">Support</p>
          <ul class="space-y-2.5">
            <li><a href="/support" class="text-sm text-muted-foreground hover:text-primary transition-colors">Support us</a></li>
            <li><a href={BRAND.supportUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-primary transition-colors">Donate</a></li>
          </ul>
        </div>

        <div class="md:col-span-2">
          <p class="overline mb-4">Legal</p>
          <ul class="space-y-2.5">
            <li><a href="/privacy" class="text-sm text-muted-foreground hover:text-primary transition-colors">Privacy policy</a></li>
            <li><a href="/terms" class="text-sm text-muted-foreground hover:text-primary transition-colors">Terms of use</a></li>
          </ul>
        </div>
      </div>

      <div class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs text-muted-foreground">&copy; {new Date().getFullYear()} {BRAND.copyright}. All rights reserved.</p>
        <p class="text-xs text-muted-foreground">Independent journalism for the public interest.</p>
      </div>
    </div>
  </footer>
</body>
</html>
