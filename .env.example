# Runtime
APP_NAME=OpenVaartha API
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
API_PORT=8000

# Public/admin access
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=https://your-domain.example

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
DATABASE_NAME=openvaartha
MONGO_INITDB_ROOT_USERNAME=openvaartha
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-mongo-password
MONGODB_URL=mongodb://openvaartha:replace-with-a-strong-mongo-password@mongo:27017/openvaartha?authSource=admin

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
CACHE_TTL_SECONDS=300
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-redis-password@redis:6379/2

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
NEWS_API_KEY=
MEDIASTACK_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
