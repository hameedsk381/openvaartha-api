APP_NAME=OpenVaartha API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PORT=8000

ADMIN_EMAILS=you@example.com
# Comma-separated exact origins. Since FastAPI serves the UI, same-origin
# requests don't need CORS — this is for admin tools / monitoring dashboards.
CORS_ORIGINS=https://your-domain.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_NAME=openvaartha
# External managed MongoDB (e.g. MongoDB Atlas). Put credentials, database and
# TLS options in the URI. Atlas gives you a mongodb+srv://... string directly.
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/openvaartha?retryWrites=true&w=majority

# External managed Redis connection string from your provider. Use rediss://
# for TLS (most managed Redis is TLS-only). A single URL is enough — Celery's
# broker and result backend reuse it automatically.
REDIS_URL=rediss://default:PASSWORD@your-redis-host:6379
CACHE_TTL_SECONDS=300
# Optional: set these only if your Redis plan offers separate logical DBs and
# you want Celery isolated from the app cache. Blank => both reuse REDIS_URL.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ── Optional: AI / News APIs ────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NEWS_API_KEY=
MEDIASTACK_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

GOOGLE_CLIENT_ID=
GCS_BUCKET_NAME=
VITE_GA_TRACKING_ID=

# ── Required for password-reset emails ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=OpenVaartha

# Used in sitemaps, RSS feeds, and canonical URLs
SITE_URL=https://your-domain.com
