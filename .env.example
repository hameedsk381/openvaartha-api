APP_NAME=OpenVaartha API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PORT=8000

ADMIN_EMAILS=you@example.com
# Comma-separated exact origins. Since FastAPI serves the UI, same-origin
# requests don't need CORS — this is for admin tools / monitoring dashboards.
CORS_ORIGINS=https://your-domain.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_NAME=openvaartha
MONGO_INITDB_ROOT_USERNAME=openvaartha
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-password
MONGODB_URL=mongodb://openvaartha:replace-with-strong-password@mongo:27017/openvaartha?authSource=admin

REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0
CACHE_TTL_SECONDS=300
CELERY_BROKER_URL=redis://:replace-with-strong-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-strong-password@redis:6379/2

# ── Optional: AI / News APIs ────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-latest
NEWS_API_KEY=
MEDIASTACK_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Required for password-reset emails ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=OpenVaartha

# Used in sitemaps, RSS feeds, and canonical URLs
SITE_URL=https://your-domain.com
